{
  "name": "@email-kit/playground",
  "private": true,
  "type": "module",
  "description": "A project to try email-kit by hand: compile, check, tokens and a browser preview",
  "scripts": {
    "compile": "email-kit compile",
    "check": "email-kit check",
    "tokens": "email-kit tokens",
    "preview": "email-kit compile --quiet && node preview.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@email-kit/components": "workspace:*",
    "@email-kit/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@email-kit/cli": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
