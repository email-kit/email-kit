{
  "name": "@email-kit/core",
  "version": "1.0.0",
  "description": "email-kit core: defineEmail, the JSX runtime and types for type-safe email templates.",
  "keywords": [
    "email",
    "email-templates",
    "jsx",
    "typescript",
    "compiler"
  ],
  "homepage": "https://github.com/email-kit/email-kit#readme",
  "bugs": "https://github.com/email-kit/email-kit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/email-kit/email-kit.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "jsx-runtime": [
        "./dist/jsx-runtime.d.ts"
      ],
      "jsx-dev-runtime": [
        "./dist/jsx-dev-runtime.d.ts"
      ],
      "internal": [
        "./dist/internal.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
