{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "customerName": {
      "type": "string"
    },
    "orderNumber": {
      "type": "string"
    },
    "orderUrl": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "qty"
        ]
      }
    },
    "discount": {
      "type": "string"
    }
  },
  "required": [
    "customerName",
    "orderNumber",
    "orderUrl",
    "items"
  ]
}
